# Started with the session, not on demand, so a value exists the first time the popup opens.
[Unit]
Description=KOSMIC tiling state
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@KOSMIC_STATED_EXE@
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
