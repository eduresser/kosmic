<?xml version="1.0" encoding="UTF-8"?>
<!-- The outline's thickness and colour live in the applet: a KWin plugin has no contents/config to
     hang a dialog on, and the applet can reload it so the change applies at once. -->
<ui version="4.0">
 <class>KosmicFocusDimConfig</class>
 <widget class="QWidget" name="KosmicFocusDimConfig">
  <layout class="QFormLayout" name="formLayout">
   <item row="0" column="0">
    <widget class="QLabel" name="labelStrength">
     <property name="text">
      <string>Strength:</string>
     </property>
    </widget>
   </item>
   <item row="0" column="1">
    <widget class="QSpinBox" name="kcfg_Strength">
     <property name="suffix">
      <string> %</string>
     </property>
     <property name="minimum">
      <number>0</number>
     </property>
     <property name="maximum">
      <number>100</number>
     </property>
     <property name="toolTip">
      <string>How far a window outside the selection is dimmed.</string>
     </property>
    </widget>
   </item>
   <item row="1" column="0">
    <widget class="QLabel" name="labelDuration">
     <property name="text">
      <string>Duration:</string>
     </property>
    </widget>
   </item>
   <item row="1" column="1">
    <widget class="QSpinBox" name="kcfg_Duration">
     <property name="suffix">
      <string> ms</string>
     </property>
     <property name="minimum">
      <number>0</number>
     </property>
     <property name="maximum">
      <number>2000</number>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
