#!/bin/sh
# One-word arguments keep the .desktop Exec lines free of quoting, where desktop files go wrong.

case "${1:-}" in
  browser)
    b="$(xdg-settings get default-web-browser 2>/dev/null)"
    [ -n "$b" ] || exec xdg-open "https://"
    gtk-launch "$b" 2>/dev/null && exit 0
    kioclient6 exec "$b" 2>/dev/null && exit 0
    exec xdg-open "https://" ;;
  home)
    exec xdg-open "$HOME" ;;
  terminal)
    t="$(kreadconfig6 --file kdeglobals --group General --key TerminalApplication 2>/dev/null)"
    # The key may hold a command line with field codes (BigLinux: `ashyterm %F`), so strip and word-split.
    t="$(printf '%s' "$t" | sed 's/%[A-Za-z%]//g')"
    # shellcheck disable=SC2086
    exec ${t:-konsole} ;;
  launcher)
    exec busctl --user call org.kde.krunner /App org.kde.krunner.App display ;;
  apps)
    exec busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell activateLauncherMenu ;;
  screenshot)
    exec spectacle ;;
  *)
    echo "usage: kosmic-open browser|home|terminal|launcher|apps|screenshot" >&2
    exit 2 ;;
esac
