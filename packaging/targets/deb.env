# One package for KDE Neon, Ubuntu and Debian: the alternatives cover the names the three use, and
# the KWin floor keeps out the releases that ship Plasma 5 or a KWin older than 6.5.
FORMAT=deb
DEPENDS=(
  "kwin-wayland (>= 4:6.5)" "kwin-dev (>= 4:6.5)" "systemd" "plasma-workspace" "procps"
  "build-essential" "cmake" "pkgconf | pkg-config" "extra-cmake-modules"
  "qt6-base-dev" "qt6-base-private-dev" "kf6-kconfig-dev | libkf6config-dev"
  "libxkbcommon-dev" "libdrm-dev"
)
