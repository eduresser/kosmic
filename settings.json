{
  "_doc": [
    "Every configuration key KOSMIC reads, with its type and default. This is the one place a",
    "default is decided; tools/gen.mjs emits the kcfg files from it and tools/parity.mjs keeps",
    "every restatement of a default elsewhere -- in C++, in the applet's QML -- equal to it.",
    "`kcfg` false means the component is a C++ plugin and carries no kcfg: it reads kwinrc direct."
  ],
  "components": {
    "kosmic-tiling": {
      "kind": "script",
      "group": "Script-kosmic-tiling",
      "path": "src/comp/script",
      "kcfg": true,
      "entries": {
        "GapInner":          { "type": "Int",  "default": 8 },
        "GapOuter":          { "type": "Int",  "default": 0 },
        "Debug":             { "type": "Bool", "default": false },
        "DropPreview":       { "type": "Bool", "default": true },
        "TabBar":            { "type": "Bool", "default": true },
        "BarHeight":         { "type": "Int",  "default": 28 },
        "StackOsd":          { "type": "Bool", "default": false },
        "ModeOsd":           { "type": "Bool", "default": true },
        "NewWorkspaceTiled": { "type": "Bool", "default": true },
        "SelectionMarker":   { "type": "Bool", "default": true },
        "ChordHold":         { "type": "Bool", "default": false }
      }
    },
    "kosmic-tiling-anim": {
      "kind": "effect",
      "group": "Effect-kosmic-tiling-anim",
      "path": "src/comp/effect",
      "kcfg": true,
      "entries": {
        "Duration": { "type": "Int",  "default": 350 },
        "Debug":    { "type": "Bool", "default": false }
      }
    },
    "kosmic-focusdim": {
      "kind": "effect",
      "group": "Effect-kosmic-focusdim",
      "path": "src/comp/focusdim",
      "kcfg": true,
      "entries": {
        "Strength": { "type": "Int",  "default": 30 },
        "Duration": { "type": "Int",  "default": 250 },
        "Debug":    { "type": "Bool", "default": false }
      }
    },
    "kosmic-outline": {
      "kind": "plugin",
      "group": "Plugin-kosmic-outline",
      "path": "src/outline",
      "kcfg": false,
      "entries": {
        "Thickness": { "type": "Int",    "default": 3 },
        "Radius":    { "type": "Int",    "default": -1 },
        "FallbackRadius": { "type": "Int", "default": 8 },
        "Opacity":   { "type": "Int",    "default": 100 },
        "Color":     { "type": "String", "default": "" },
        "Debug":     { "type": "Bool",   "default": false }
      }
    }
  }
}
